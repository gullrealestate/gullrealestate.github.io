    "gh-pages": "^6.3.0",
    "globals": "^17.3.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.3",
    "puppeteer": "^24.37.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "terser": "^5.51.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "minimatch": "^10.2.2"
